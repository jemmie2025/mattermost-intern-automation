# Application
APP_ENV=development
BUSINESS_TIMEZONE=Africa/Lagos
# n8n is the live orchestrator; enable only for local fallback testing.
SCHEDULER_ENABLED=false
CHECKIN_TIME=08:30
WORKLOG_TIME=16:30
CHECKOUT_TIME=17:00
DIGEST_TIME=17:15
FAQ_PATH=config/faqs.yaml

# PostgreSQL used by Docker Compose
POSTGRES_DB=intern_bot
POSTGRES_USER=intern_bot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://intern_bot:replace-with-a-long-random-password@postgres:5432/intern_bot

# Mattermost — obtain from the system administrator; never commit real values
MATTERMOST_URL=https://mattermost.example.internal
MATTERMOST_BOT_TOKEN=replace-with-bot-token
MATTERMOST_BOT_USER_ID=replace-with-bot-user-id
ATTENDANCE_CHANNEL_ID=replace-with-test-channel-id
MENTOR_CHANNEL_ID=replace-with-mentor-channel-id
TLS_CA_FILE=
REQUEST_TIMEOUT_SECONDS=10

# Mattermost creates a separate verification token for each slash command/webhook
MM_CHECKIN_TOKEN=replace-with-checkin-command-token
MM_CHECKOUT_TOKEN=replace-with-checkout-command-token
MM_TASK_TOKEN=replace-with-task-command-token
MM_FAQ_TOKEN=replace-with-faq-command-token
MM_OUTGOING_WEBHOOK_TOKEN=replace-with-outgoing-webhook-token
MM_ACTION_TOKEN=replace-with-action-token

# Mentor/admin access
ADMIN_API_KEY=replace-with-a-long-random-admin-key
AUTOMATION_API_KEY=replace-with-a-separate-long-random-n8n-key
MENTOR_USER_IDS=replace-with-mattermost-user-id
